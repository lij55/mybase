# Generated by make init; unmodified generated files are refreshed; custom files are preserved.
# Run Caddy on the host. TLS is terminated by your external HTTPS ingress.
# Preserve the original Host header when forwarding to this listener.
# For direct public HTTPS, see docs/deployment.md.
http://:@@CADDY_PORT@@ {
	bind @@CADDY_BIND@@
	header -Server

	@api host @@CADDY_API_HOST@@
	handle @api {
		reverse_proxy 127.0.0.1:@@PUBLIC_API_PORT@@
	}

	@admin host @@CADDY_ADMIN_HOST@@
	handle @admin {
		# Envoy enforces DASHBOARD_USERNAME / DASHBOARD_PASSWORD for Studio.
		reverse_proxy 127.0.0.1:@@STUDIO_PORT@@
	}

	# Unknown hosts must never fall through to Studio.
	handle {
		respond "Not found" 404
	}
}
