# 复制为 demoapp/.env，由 Compose 读取，不要在 shell 中 source。
# 来源：根 .env 的 COMPOSE_PROJECT_NAME 加 _default；默认 mybase_default。
SUPABASE_DOCKER_NETWORK=mybase_default
# 来源：Supabase Compose 内部网关服务 api-gw 的地址，浏览器公网地址不用于此处。
SUPABASE_URL=http://api-gw:8000
# 来源：仓库根 .env 的 ANON_KEY。
SUPABASE_ANON_KEY=
# 来源：仓库根 .env 的 SERVICE_ROLE_KEY；仅注入 admin。
SUPABASE_SERVICE_ROLE_KEY=
# 来源：admin/sql/000_prepare.sql 的 PostgreSQL 账号 app_authorizer 和密码。
# 密码取该 SQL 中 PASSWORD 的值并 URL 编码；主机 db，端口 5432，数据库 postgres。
# 修改 SQL 密码时，同步修改下面连接串中的密码。
DATABASE_URL=postgresql://app_authorizer:demo-app-authorizer-change-me@db:5432/postgres
# 来源：python3 demoapp/bootstrap_admin.py 输出的 Supabase Auth 用户 UUID，
# 或现有 Auth 管理入口中用户的 UUID；多个 UUID 逗号分隔。不是上述数据库账号。
ADMIN_USER_IDS=
# 来源：宿主机 Traefik 监听地址；本机访问用 127.0.0.1，对外监听用 0.0.0.0。
TRAEFIK_BIND=127.0.0.1
# 来源：自行选择的宿主机空闲端口，默认 8090。
TRAEFIK_PORT=8090
# 来源：浏览器访问各 App 的域名，须解析到 Traefik 所在宿主机。
# 本机可用以下 .localhost 默认值；远程访问时填写实际域名。
ADMIN_HOST=authz.localhost
TODO_HOST=todo.localhost
NOTES_HOST=notes.localhost
