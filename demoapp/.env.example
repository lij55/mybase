# Copy to .env; this file is read by Compose, never source it in a shell.
SUPABASE_DOCKER_NETWORK=mybase_default
SUPABASE_URL=http://api-gw:8000
SUPABASE_ANON_KEY=
# Only injected into admin, never into todo/notes or frontend assets.
SUPABASE_SERVICE_ROLE_KEY=
# Use a dedicated DB login granted the app_authorizer role; URL-encode password.
DATABASE_URL=postgresql://demo_authorizer:REPLACE_WITH_URL_ENCODED_PASSWORD@db:5432/postgres
# Existing Supabase Auth UUIDs, comma separated. Not memberships and not emails.
ADMIN_USER_IDS=
TRAEFIK_BIND=127.0.0.1
TRAEFIK_PORT=8090
ADMIN_HOST=authz.localhost
TODO_HOST=todo.localhost
NOTES_HOST=notes.localhost
