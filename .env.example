# make init 自动生成密钥；已有非空密钥不会覆盖。不要将此文件 source。
# Caddy 和 Supabase 共用域名，默认 API / 管理入口：
# https://api.my.supabase.local / https://admin.my.supabase.local
PUBLIC_HOST=my.supabase.local

# 自动生成的密钥，请妥善保存，不要提交到版本库。
POSTGRES_PASSWORD=
JWT_SECRET=
DASHBOARD_PASSWORD=
SECRET_KEY_BASE=
REALTIME_DB_ENC_KEY=
VAULT_ENC_KEY=
PG_META_CRYPTO_KEY=
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
