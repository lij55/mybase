# Supabase 本地部署环境变量模板；详细说明见 docs/configuration.md 与 docs/containers.md。
# 运行 make init 或 make up 会生成 .env 并补全空密钥，已有非空值不会覆盖。
# 修改此模板不会改变正在运行的实例；实际配置位于 .env，修改后运行 make up 应用。
# 不要将 .env 作为 shell 脚本 source。值按字面量读取，含 $ 或 # 时用单引号包裹。
# 不支持多行值、变量插值或复杂转义；不要在赋值行末追加注释。
# 此模板保留上游高级参数供参考；未部署组件的变量不会自动启用对应组件。
# 上游可选 run.sh、utils 和其他 Compose 组合文件未打包，请按本项目文档操作。

############
# 配置文件组合
############

# Compose 配置文件列表，以冒号分隔、基础文件在前。本项目固定使用以下两个文件。
COMPOSE_FILE=docker-compose.yml:compose.override.yml

############
# 密钥与管理凭证
############

# 数据库初始化密码及内部服务连接密码；由 make init 随机生成。已有数据库改密码需同步更新数据库角色。
POSTGRES_PASSWORD=

# 当前 HS256 模式的 JWT 签名密钥，由 make init 生成；必须与下面两枚 API JWT 配套。
JWT_SECRET=

# 匿名角色 API JWT，可供前端使用；数据权限仍由数据库 grants 与 RLS 控制。
ANON_KEY=

# 管理角色 API JWT，可绕过 RLS；只能放在可信服务端，禁止暴露到前端。
SERVICE_ROLE_KEY=

# 新式客户端公开 API key。当前部署未启用，保持为空；迁移方式见 docs/configuration.md。
SUPABASE_PUBLISHABLE_KEY=

# 新式服务端秘密 API key。当前部署未启用，保持为空；禁止公开。
SUPABASE_SECRET_KEY=

# Auth 使用的签名 JWK 数组，可含 EC 私钥与旧对称密钥；当前 HS256 部署保持为空。
JWT_KEYS=

# 其他服务用于验证 token 的 JWKS；当前部署保持为空，不能只填此项就完成 ES256 迁移。
JWT_JWKS=

# Studio 管理后台的 HTTP Basic Auth 用户名，不是业务用户账号。
DASHBOARD_USERNAME=supabase

# Studio 管理后台密码，由 make init 生成；按本封装要求使用字母、数字、下划线或连字符。
DASHBOARD_PASSWORD=

# Realtime 与 Supavisor 使用的秘密材料；本封装生成 96 个十六进制字符。请勿随意轮换。
SECRET_KEY_BASE=

# Realtime 加密 _realtime 内敏感配置的密钥，必须恰好 16 个字符。
REALTIME_DB_ENC_KEY=

# Supavisor 加密连接配置的密钥，必须恰好 32 个字符；不是数据库 Vault 扩展的总开关。
VAULT_ENC_KEY=

# Studio 与 postgres-meta 保护连接信息使用的共享加密密钥，本封装生成 64 个十六进制字符。
PG_META_CRYPTO_KEY=

# 可选 Logflare/Vector 日志写入 token；当前没有部署日志聚合容器，仅保留变量。
LOGFLARE_PUBLIC_ACCESS_TOKEN=

# 可选 Logflare 管理 token；当前未使用，启用日志栈后也不能暴露到前端。
LOGFLARE_PRIVATE_ACCESS_TOKEN=

# Storage 的 S3 兼容接口访问标识；不是外部 S3 存储后端的访问密钥。
S3_PROTOCOL_ACCESS_KEY_ID=

# 与上项配套的 S3 兼容接口秘密凭证；仅用于可信客户端，不放入浏览器。
S3_PROTOCOL_ACCESS_KEY_SECRET=

############
# 对外 URL
############

# 前端 SDK 使用的业务 API 根地址；公网部署改成 https://api.example.com。
SUPABASE_PUBLIC_URL=http://localhost:8000

# 本版本 Auth 的完整外部地址，必须是 SUPABASE_PUBLIC_URL 加 /auth/v1，用于认证回调和邮件链接。
API_EXTERNAL_URL=http://localhost:8000/auth/v1

############
# 数据库
############

# Docker 网络内数据库服务名；本封装固定为 db。
POSTGRES_HOST=db

# 数据库名称；本封装固定为 postgres。
POSTGRES_DB=postgres

# 容器内部 PostgreSQL 端口，固定为 5432；宿主机端口请改 DB_SESSION_PORT / DB_TRANSACTION_PORT。
POSTGRES_PORT=5432

############
# 数据库连接池
############

# 上游事务池宿主机端口变量；本项目已由 DB_TRANSACTION_PORT 覆盖，保留作参考。
POOLER_PROXY_PORT_TRANSACTION=6543

# 每个连接池允许打开的数据库连接数，默认 20；不是整个实例的总连接数上限。
POOLER_DEFAULT_POOL_SIZE=20

# 每个连接池允许接入的客户端连接数上限，默认 100。
POOLER_MAX_CLIENT_CONN=100

# Supavisor 租户标识；连接用户名使用 postgres.mybase 这样的 用户名.租户标识 格式。
POOLER_TENANT_ID=mybase

# Supavisor 自身访问内部元数据数据库的连接池大小，与业务连接池分开。
POOLER_DB_POOL_SIZE=5

############
# Studio 管理界面
############

# Studio 中默认显示的组织名称，仅作展示，不代表托管平台的组织管理功能。
STUDIO_DEFAULT_ORGANIZATION=Default Organization

# Studio 中默认显示的项目名称；当前是一套单项目实例。
STUDIO_DEFAULT_PROJECT=Default Project

# Studio AI 辅助功能的可选服务端密钥；默认留空，填写前评估外部调用与数据传输。
OPENAI_API_KEY=

############
# Auth 认证与邮件
############

# 前端业务站点地址，用作 Auth 默认跳转目标；不是 Supabase API 地址。
SITE_URL=http://localhost:3000

# 额外允许的认证跳转 URL，多个值以逗号分隔；生产环境避免过宽通配符。
ADDITIONAL_REDIRECT_URLS=

# 业务用户 access token 有效期，单位秒；3600 为一小时，不是 ANON_KEY 的有效期。
JWT_EXPIRY=3600

# 是否禁止新用户注册；默认 true。已有用户登录不因此被禁用。
DISABLE_SIGNUP=true

# 注册确认邮件的验证路径，本版本使用 /auth/v1/verify。
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"

# 邀请邮件的验证路径。
MAILER_URLPATHS_INVITE="/auth/v1/verify"

# 找回密码邮件的验证路径。
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"

# 修改邮箱邮件的验证路径。
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

# 是否启用邮箱认证能力；新用户注册还受 DISABLE_SIGNUP 控制。
ENABLE_EMAIL_SIGNUP=true

# 是否跳过邮箱确认；默认 false，公网模式禁止设为 true。
ENABLE_EMAIL_AUTOCONFIRM=false

# 发件邮箱地址；需通过邮件供应商的发信域名验证，示例地址必须替换。
SMTP_ADMIN_EMAIL=admin@example.com

# SMTP 服务器地址；默认留空，当前不会自动提供邮件服务。
SMTP_HOST=

# SMTP 端口；按供应商配置填写，默认 587。
SMTP_PORT=587

# SMTP 认证用户名。
SMTP_USER=

# SMTP 认证密码；包含 $ 或 # 时使用单引号字面值包裹。
SMTP_PASS=

# 邮件显示的发件人名称。
SMTP_SENDER_NAME=Mybase

# 是否允许创建匿名 Auth 用户；与前端使用公开 ANON_KEY 不是同一概念，默认关闭。
ENABLE_ANONYMOUS_USERS=false

# 是否启用手机号认证，默认关闭；启用时还要配置真实短信供应商。
ENABLE_PHONE_SIGNUP=false

# 是否跳过手机号确认，默认关闭；公网模式禁止跳过。
ENABLE_PHONE_AUTOCONFIRM=false

############
# Storage 与上游可选对象存储
############

# Storage 使用的底层存储位置标识；当前为 file 后端目录标识，不是业务 bucket 名称。
GLOBAL_S3_BUCKET=stub

# Storage/S3 协议使用的区域标识；当前 file 后端使用占位值。
REGION=stub

# 上游可选 MinIO 的管理员用户名；当前未部署 MinIO，该值不生效。
MINIO_ROOT_USER=supa-storage

# 上游可选 MinIO/RustFS 的管理员密码；当前未部署这些容器，make init 仍会生成备用值。
MINIO_ROOT_PASSWORD=

# Storage 的租户标识，供 S3 协议等内部配置使用；不是最终业务用户 ID。
STORAGE_TENANT_ID=stub

############
# Edge Functions 服务端函数
############

# 是否在函数入口统一检查 JWT，默认 true；所有函数共用，函数内仍需验证具体用户权限。
FUNCTIONS_VERIFY_JWT=true

############
# PostgREST 数据 API
############

# REST API 可访问的数据库 schema 列表。列入列表不代表其中所有对象均获授权。
PGRST_DB_SCHEMAS=public,graphql_public

# PostgREST 单次请求返回的最大行数，默认 1000；更多数据请分页。
PGRST_DB_MAX_ROWS=1000

# 请求执行时额外加入 search_path 的 schema，不等于直接对外暴露这些 schema。
PGRST_DB_EXTRA_SEARCH_PATH=public

############
# 上游可选日志组件（当前未部署）
############

# 可选 Vector 读取 Docker 日志所用的 socket 路径；当前未部署 Vector，无需挂载。
DOCKER_SOCKET_LOCATION=/var/run/docker.sock

# 可选 Logflare 外部日志后端的 Google Cloud 项目标识；当前未使用。
GOOGLE_PROJECT_ID=GOOGLE_PROJECT_ID

# 可选 Logflare 外部日志后端的 Google Cloud 项目编号；当前未使用。
GOOGLE_PROJECT_NUMBER=GOOGLE_PROJECT_NUMBER

############
# 上游网关兼容参数
############

# 上游网关宿主机端口变量；本项目由 STUDIO_PORT 覆盖，不用于业务入口。
API_GW_HTTP_PORT=8000

# 上游可选 Kong 的 HTTP 端口；当前使用 Envoy，不使用此项。
KONG_HTTP_PORT=8000

# 上游可选 Kong 的 HTTPS 端口；当前未部署 Kong。
KONG_HTTPS_PORT=8443

# ES256 模式下网关内部使用的匿名角色预签 JWT；当前保持为空，不供业务代码使用。
ANON_KEY_ASYMMETRIC=

# ES256 模式下网关内部使用的管理角色预签 JWT；当前保持为空，不供业务代码使用。
SERVICE_ROLE_KEY_ASYMMETRIC=

############
# 图片转换
############

# 启用 imgproxy 自动 WebP 支持；实际图片转换需通过 Storage 转换接口请求。
IMGPROXY_AUTO_WEBP=true

############
# 上游可选 TLS 代理（当前未部署）
############

# 上游可选 Caddy/Nginx TLS 代理使用的域名；当前 Tunnel 方案不读取此项。
PROXY_DOMAIN=your-domain.example.com

# 上游可选 Certbot 的证书通知邮箱；当前未部署 Certbot，该值不生效。
CERTBOT_EMAIL=admin@example.com

############
# 本项目的实际端口与 Caddy 配置
############

# Docker 项目名，决定网络与命名卷名称；初次部署前确定，已有数据后不要随意更改。
COMPOSE_PROJECT_NAME=mybase

# 仅绑定 127.0.0.1 的业务 API 端口，默认 8000；改动后同步修改 API URL。
PUBLIC_API_PORT=8000

# 仅绑定 127.0.0.1 的管理网关端口，默认 8001；通过它访问 Studio。
STUDIO_PORT=8001

# 仅绑定 127.0.0.1 的 Session 模式连接池端口，适合 SQL 客户端和迁移。
DB_SESSION_PORT=5432

# 仅绑定 127.0.0.1 的 Transaction 模式连接池端口，适合短事务连接。
DB_TRANSACTION_PORT=6543

# make up 等待容器健康的秒数；不包含镜像下载时间。
UP_TIMEOUT=300

# Storage 单文件大小上限，单位字节，默认 50 MiB；修改时还要检查 Nginx 和 Cloudflare 限制。
STORAGE_FILE_SIZE_LIMIT=52428800

# make init 首次生成 caddy/Caddyfile 使用；修改后需同步编辑已生成的文件。
# 宿主机 Caddy 只监听 127.0.0.1，供外部 HTTPS 入口转发，保留原始 Host。
CADDY_API_HOST=api.localhost
CADDY_ADMIN_HOST=admin.localhost
CADDY_PORT=8080

############
# 可选认证配置示例（均未启用）
############
# 仅取消下列变量的注释不足以启用功能，还须在 Compose 中配置对应 GOTRUE_* 环境变量。
# OAuth、短信、MFA、SAML 的业务回调、供应商凭证及权限需要单独验证。
#   COMPOSE_FILE=docker-compose.yml
#   COMPOSE_FILE=docker-compose.yml:docker-compose.pg17.yml

# Google 登录：启用开关、客户端标识与客户端秘密凭证。
# GOOGLE_ENABLED=false
# GOOGLE_CLIENT_ID=
# GOOGLE_SECRET=

# GitHub 登录：启用开关、客户端标识与客户端秘密凭证。
# GITHUB_ENABLED=false
# GITHUB_CLIENT_ID=
# GITHUB_SECRET=

# Azure 登录：启用开关、客户端标识与客户端秘密凭证。
# AZURE_ENABLED=false
# AZURE_CLIENT_ID=
# AZURE_SECRET=

# 短信供应商及验证码的有效秒数、位数、发送间隔和消息模板；模板内容可自行本地化。
# SMS_PROVIDER=twilio
# SMS_OTP_EXP=60
# SMS_OTP_LENGTH=6
# SMS_MAX_FREQUENCY=60s
# SMS_TEMPLATE=Your code is {{ .Code }}

# Twilio 短信账户标识、认证 token 与消息服务标识。
# SMS_TWILIO_ACCOUNT_SID=
# SMS_TWILIO_AUTH_TOKEN=
# SMS_TWILIO_MESSAGE_SERVICE_SID=

# 仅开发使用的固定验证码映射，格式为 手机号1:验证码1,手机号2:验证码2。
# SMS_TEST_OTP=

# 身份验证器 TOTP 的注册/验证开关；此处是上游默认值示例，当前未做 MFA 端到端验收。
# MFA_TOTP_ENROLL_ENABLED=true
# MFA_TOTP_VERIFY_ENABLED=true

# 手机 MFA 的注册/验证开关，默认关闭，需先接入短信供应商。
# MFA_PHONE_ENROLL_ENABLED=false
# MFA_PHONE_VERIFY_ENABLED=false

# 单用户最多可注册的 MFA 因子数量。
# MFA_MAX_ENROLLED_FACTORS=10

# SAML SSO 开关与 Base64 编码私钥；当前未启用。
# SAML_ENABLED=true
# SAML_PRIVATE_KEY=<your-base64-encoded-private-key>

# 是否接收身份提供方的加密 SAML 断言。
# SAML_ALLOW_ENCRYPTED_ASSERTIONS=false

# SAML 中继状态的有效时长，示例为两分钟。
# SAML_RELAY_STATE_VALIDITY_PERIOD=2m0s

# 可选 SAML 实体标识/ACS 基础 URL；不设置时使用 API_EXTERNAL_URL。
# SAML_EXTERNAL_URL=https://supabase.example.com:8000/auth/v1

# SAML ACS 接口每秒请求数限制。
# SAML_RATE_LIMIT_ASSERTION=15

# 官方认证配置文档：https://supabase.com/docs/guides/self-hosting/self-hosted-oauth
# 新式密钥迁移文档：https://supabase.com/docs/guides/self-hosting/self-hosted-auth-keys
